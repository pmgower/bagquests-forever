package-as: BagQuests

move-folders:
  BagQuests/BagQuests: BagQuests
  BagQuests/BagQuests_Alts: BagQuests_Alts

ignore:
  - tests
  - curseforge
  - docs
  - CONTRIBUTING.md
  - .luacheckrc
  - .github
  - README.md
  - "*.zip"

# CurseForge and GitHub release notes come from this hand-written file, not
# the commit list. Keep it to the version being released (short, player-facing).
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
